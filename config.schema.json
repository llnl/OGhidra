{
  "$defs": {
    "HttpServerConfig": {
      "additionalProperties": false,
      "properties": {
        "evidence_tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Tools",
          "type": "array"
        },
        "transport": {
          "enum": [
            "sse",
            "streamable-http"
          ],
          "title": "Transport",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "url"
      ],
      "title": "HttpServerConfig",
      "type": "object"
    },
    "LMConfig": {
      "additionalProperties": false,
      "description": "DSPy/LiteLLM settings",
      "properties": {
        "api_base": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "API base URL, separate from model. For an OpenAI-compatible server, typically http://127.0.0.1:8000/v1; for native Ollama, http://127.0.0.1:11434. Do not append /models or /chat/completions. Omit to use the provider's default endpoint.",
          "title": "Api Base"
        },
        "api_key_env": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the environment variable containing this LM endpoint's API key, not the key itself. It must be available to the MCP server process. Omit for an endpoint that needs no key.",
          "title": "Api Key Env"
        },
        "cache": {
          "default": false,
          "title": "Cache",
          "type": "boolean"
        },
        "max_tokens": {
          "default": 4096,
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "model": {
          "description": "DSPy/LiteLLM identifier: <provider>/<exact model ID>. The first prefix selects the API integration; the remaining ID may contain slashes. This is not a URL. No aliases or prefix rewriting are applied. For a server ID openai/gpt-oss-120b, use hosted_vllm/openai/gpt-oss-120b or openai/openai/gpt-oss-120b.",
          "examples": [
            "openai/gpt-4o",
            "anthropic/claude-sonnet-4-5-20250929",
            "ollama_chat/llama3.2",
            "hosted_vllm/openai/gpt-oss-120b",
            "openai/openai/gpt-oss-120b"
          ],
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "num_retries": {
          "default": 3,
          "minimum": 0,
          "title": "Num Retries",
          "type": "integer"
        },
        "ssl_verify": {
          "default": true,
          "description": "Verify HTTPS server certificates. Keep true for internal servers too; certificate trust is configured by application startup (for example, truststore), not by this configuration model.",
          "title": "Ssl Verify",
          "type": "boolean"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "timeout": {
          "default": 120.0,
          "exclusiveMinimum": 0,
          "title": "Timeout",
          "type": "number"
        }
      },
      "required": [
        "model"
      ],
      "title": "LMConfig",
      "type": "object"
    },
    "StdioServerConfig": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "evidence_tools": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Tools",
          "type": "array"
        },
        "transport": {
          "const": "stdio",
          "default": "stdio",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "title": "StdioServerConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compiled_predictor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compiled Predictor"
    },
    "lm": {
      "$ref": "#/$defs/LMConfig"
    },
    "log_backup_count": {
      "default": 3,
      "minimum": 1,
      "title": "Log Backup Count",
      "type": "integer"
    },
    "log_file": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "logs/oghidra-{pid}.jsonl",
      "title": "Log File"
    },
    "log_level": {
      "default": "INFO",
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "title": "Log Level",
      "type": "string"
    },
    "log_max_bytes": {
      "default": 5000000,
      "exclusiveMinimum": 0,
      "title": "Log Max Bytes",
      "type": "integer"
    },
    "max_iters": {
      "default": 6,
      "exclusiveMinimum": 0,
      "title": "Max Iters",
      "type": "integer"
    },
    "mcp_servers": {
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]*$": {
          "discriminator": {
            "mapping": {
              "sse": "#/$defs/HttpServerConfig",
              "stdio": "#/$defs/StdioServerConfig",
              "streamable-http": "#/$defs/HttpServerConfig"
            },
            "propertyName": "transport"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/StdioServerConfig"
            },
            {
              "$ref": "#/$defs/HttpServerConfig"
            }
          ]
        }
      },
      "required": [
        "ghidra"
      ],
      "title": "Mcp Servers",
      "type": "object"
    }
  },
  "required": [
    "lm",
    "mcp_servers"
  ],
  "title": "AppConfig",
  "type": "object"
}
