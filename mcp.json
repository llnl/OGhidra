{
  "mcpServers": {
    "pyghidra": {
      "type": "http",
      "url": "http://127.0.0.1:8001/mcp"
    },
    "oghidra": {
      "type": "stdio",
      "command": "C:/!dev/OGhidra/.venv/Scripts/python.exe",
      "args": [
        "C:/!dev/OGhidra/main.py"
      ],
      "env": {
        "OGHIDRA_MODEL_API_KEY": "your-model-api-key"
      }
    }
  }
}
